   "source": [
    "for i in range (0, 5100, 100):\n",
    "    lbz = LBZ_pi(i)\n",
    "    RE = abs(LBZ_pi(i) - np.pi) / np.pi\n",
    "    print (i, lbz, RE)"
   ]
