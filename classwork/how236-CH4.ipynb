   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def LBZ_pi(N):\n",
    "    n = np.arange(N)\n",
    "    return 4 * np.sum(((-1)**n) / (2*n + 1))"
   ]
  },
